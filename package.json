{
  "name": "jarvis-assistant",
  "version": "0.1.0",
  "description": "Voice-First AI Assistant with Internet and Human-Like Browser Control",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
